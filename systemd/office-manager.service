[Unit]
Description=Pixel Office -- the manager (Codex on the user's ChatGPT plan, in a container with only its office token)
After=office-server.service docker.service
Requires=office-server.service

[Service]
Environment=DOCKER_HOST=unix:///run/user/1001/docker.sock
WorkingDirectory=%h/pixel-office-home/pixel-office
ExecStartPre=-/usr/bin/docker rm -f office-manager
# MANAGER_BACKEND=langchain switches back to the paid LangChain manager (needs no Codex login)
ExecStart=/usr/bin/docker run --rm --name office-manager --env-file %h/pixel-office/manager.env \
  -e MANAGER_BACKEND=codex -e MANAGER_HEARTBEAT_S=3600 \
  -v %h/pixel-office-home/pixel-office:/app:ro -v %h/pixel-office/manager-codex:/codex \
  -v %h/pixel-office/manager-state:/state pixel-office-manager
ExecStop=/usr/bin/docker stop -t 30 office-manager
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
